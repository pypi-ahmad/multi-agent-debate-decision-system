# Copy this file to .env and fill in your own values.
# python-dotenv never overrides variables already set in the OS environment.

# OpenAI (dropdown: gpt-5.6-luna; reasoning effort medium)
# User OS env wins if already set. Fill here only when you have no OS env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Agnes AI (fixed model agnes-2.5-flash)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Google Gemini (dropdown: gemini-3.5-flash-lite, gemini-3.7-flash)
GOOGLE_API_KEY=

# Local Ollama (models listed dynamically from this server)
OLLAMA_BASE_URL=http://localhost:11434

# RAG embeddings: auto tries Ollama (nomic-embed-text / bge-small), else hashed
RAG_EMBED_BACKEND=auto
RAG_EMBED_MODEL=nomic-embed-text
