# Copy this file to .env and fill in your own values.
# python-dotenv never overrides variables already set in the OS environment.

# OpenAI-compatible endpoint (dropdown: gpt-5.6-luna, gpt-5.6-terra; medium effort)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Agnes AI (fixed model agnes-2.5-flash)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Google Gemini (dropdown: gemini-3.5-flash-lite, gemini-3.7-flash)
GOOGLE_API_KEY=

# Local Ollama (models listed dynamically from this server)
OLLAMA_BASE_URL=http://localhost:11434
